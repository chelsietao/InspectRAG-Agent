  "components": {
    "schemas": {
      "Body_upload_cases__case_id__images_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_cases__case_id__images_post"
      },
      "Confirmation": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accepted"
        ],
        "title": "Confirmation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewCase": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "NewCase"
      },
      "NewFact": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1,
            "title": "Text"
          },
          "image_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "accepted"
        ],
        "title": "NewFact"
      },
      "NewReport": {
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id"
        ],
        "title": "NewReport"
      },
      "NewRun": {
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^(analysis|references|agent)$",
            "title": "Kind"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "title": "Question",
            "default": ""
          },
          "image_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Id"
          },
          "memory_image_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory Image Id"
          },
          "use_case_memory": {
            "type": "boolean",
            "title": "Use Case Memory",
            "default": false
          },
          "context_run_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Run Id"
          },
          "request_key": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Request Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "request_key"
        ],
        "title": "NewRun"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
